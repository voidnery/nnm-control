#!/bin/sh
# postinst: writes /etc/nnm-control/nnm-control.env from debconf answers,
# generates secrets once (idempotent across upgrades), starts the service.
set -e
. /usr/share/debconf/confmodule

ENV_DIR=/etc/nnm-control
ENV_FILE=$ENV_DIR/nnm-control.env

db_get nnm-control/domain; APP_DOMAIN="$RET"
db_get nnm-control/port;   APP_PORT="$RET"

mkdir -p "$ENV_DIR"
touch "$ENV_FILE"
chmod 600 "$ENV_FILE"

# set_var KEY VALUE — replace existing line or append (idempotent).
set_var() {
    key="$1"; value="$2"
    if grep -q "^${key}=" "$ENV_FILE"; then
        # value may contain '/', use '|' as sed delimiter
        sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
    else
        echo "${key}=${value}" >> "$ENV_FILE"
    fi
}
# ensure_secret KEY — generate only if absent (survives upgrades/reconfigure).
ensure_secret() {
    key="$1"; bytes="$2"
    if ! grep -q "^${key}=" "$ENV_FILE"; then
        echo "${key}=$(head -c "$bytes" /dev/urandom | od -An -tx1 | tr -d ' \n')" >> "$ENV_FILE"
    fi
}

set_var APP_DOMAIN "$APP_DOMAIN"
set_var APP_PORT "$APP_PORT"
set_var MONGO_URI "mongodb://mongo:27017/nnm_control"
# The installed package version may carry a Debian epoch (e.g. 1:0.59.0). A
# docker image tag cannot contain a colon, so strip a leading "N:" before using
# it as NC_VERSION — the images are pushed under the epoch-free tag. "latest"
# and plain versions pass through unchanged.
NCV="$(dpkg-query -W -f='${Version}' nnm-control 2>/dev/null || echo latest)"
NCV="${NCV#*:}"
set_var NC_VERSION "$NCV"
ensure_secret JWT_SECRET 32
ensure_secret ZABBIX_TOKEN 24
ensure_secret SETUP_TOKEN 16

# Owner of the ghcr images; kept in env so forks can point elsewhere.
if ! grep -q '^NC_GHCR_OWNER=' "$ENV_FILE"; then
    echo "NC_GHCR_OWNER=__OWNER__" >> "$ENV_FILE"
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable nnm-control.service >/dev/null 2>&1 || true
        mkdir -p /var/lib/nnm-control/backups && chmod 700 /var/lib/nnm-control/backups
        systemctl enable nnm-control-backup.timer >/dev/null 2>&1 || true
        systemctl start nnm-control-backup.timer >/dev/null 2>&1 || true
    # Pull images before (re)start so a broken pull doesn't leave the old stack
    # down.
    #
    # This used to swallow the failure — `2>/dev/null` and a one-line warning —
    # and it is what 1.20.0 died of on 2026-08-19. The pull did not finish, the
    # unit then pulled again inside its own start, and systemd killed it at
    # TimeoutStartSec while an image was half-downloaded. Package installed,
    # stack down, apt satisfied.
    #
    # So: retried, with its output visible, and the outcome remembered.
    PULL_OK=0
    for attempt in 1 2 3; do
        if docker compose -f /opt/nnm-control/docker-compose.yml \
            --env-file "$ENV_FILE" pull; then
            PULL_OK=1; break
        fi
        echo "nnm-control: image pull attempt ${attempt} failed" >&2
        [ "$attempt" -lt 3 ] && sleep 10
    done

    START_OK=0
    if [ "$PULL_OK" = 1 ]; then
        if systemctl restart nnm-control.service; then START_OK=1; fi
    else
        # Starting the service now would repeat the pull inside a unit with a
        # start timeout, which is exactly how the stack was left down. Better to
        # stop here and say so than to make it worse while looking busy.
        echo "nnm-control: images could not be pulled; NOT restarting the service." >&2
        echo "nnm-control: the previous version keeps running. Fix connectivity, then:" >&2
        echo "nnm-control:   systemctl restart nnm-control" >&2
    fi

    if [ "$START_OK" != 1 ]; then
        # No banner, no setup token, no reassuring box. An install that left the
        # panel down must not read as an install that worked — that is how an
        # operator finds out from a browser instead of from apt.
        echo "" >&2
        echo "==============================================================" >&2
        echo " NNM Control ${NCV}: PACKAGE UNPACKED, PANEL NOT RUNNING." >&2
        echo "" >&2
        echo "   docker compose images pulled: $([ "$PULL_OK" = 1 ] && echo yes || echo no)" >&2
        echo "   service started:              no" >&2
        echo "" >&2
        echo "   systemctl status nnm-control --no-pager" >&2
        echo "   journalctl -u nnm-control -n 60 --no-pager" >&2
        echo "==============================================================" >&2
        db_stop || true
        exit 1
    fi
fi

SETUP_TOKEN_VALUE=$(grep '^SETUP_TOKEN=' "$ENV_FILE" | cut -d= -f2)
echo ""
echo "=============================================================="
echo " NNM Control installed."
echo "   Panel URL:    http://${APP_DOMAIN}:${APP_PORT}"
echo "   (DNS A-record for ${APP_DOMAIN} must point to this machine)"
echo ""
echo " FIRST-RUN SETUP TOKEN (needed once, to create the superadmin"
echo " account in the web UI on first open):"
echo ""
echo "   ${SETUP_TOKEN_VALUE}"
echo ""
echo " Manage:  nnm-control status|logs|restart|configure"
echo "=============================================================="

db_stop || true
exit 0
