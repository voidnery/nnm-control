# NNM-Control — every setting of /etc/nnm-control/nnm-control.env, without values.
# The package writes that file on first install (0600, root) and generates the secrets; an upgrade
# keeps it. After editing: sudo systemctl restart nnm-control

# Answers of the installer (debconf: sudo dpkg-reconfigure nnm-control)
APP_DOMAIN=
APP_PORT=8090

# Generated once by the installer. JWT_SECRET also derives the key that encrypts stored WMSPanel and
# server tokens: changing it makes them unreadable.
JWT_SECRET=
SETUP_TOKEN=
ZABBIX_TOKEN=

# Optional
JWT_TTL=12h
# Proxy hops in front of the panel (nginx of the stack = 1; + a CDN or host nginx = 2)
TRUST_PROXY=1
# Nightly backup (nnm-control backup): archives kept, and their total cap in GB
NNM_BACKUP_KEEP=14
NNM_BACKUP_MAX_GB=20
